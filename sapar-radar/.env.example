# Copy to .env (git-ignored) and fill in.

# --- required for real runs -------------------------------------------------
# Google Cloud console -> enable "Places API (New)" -> create an API key.
# Restrict the key to the Places API.
GOOGLE_MAPS_API_KEY=

# --- optional: web-wide verification (classification.web_verify: true) ------
# Programmable Search Engine (https://programmablesearchengine.google.com)
# configured to "Search the entire web", plus a Custom Search JSON API key.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- optional: delivery -----------------------------------------------------
# Telegram: talk to @BotFather for the token, @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Gmail needs an App Password, not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
