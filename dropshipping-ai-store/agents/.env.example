# ספק ה-LLM שמריץ את הסוכנים — נדרש לפחות אחד
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# מזהה המודל (תואם ל-LiteLLM, המנוע שמריץ CrewAI). עדכנו לפי המודל הזמין לכם.
CREWAI_MODEL=anthropic/claude-sonnet-5

# הנישה שסוכן המחקר יתחיל ממנה (ריצת דמו)
TARGET_NICHE=home gadgets

# Shopify — למילוי בשלב 1 של מפת הדרכים (docs/04-roadmap.md)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# כתובת Webhook לשליחת דוח האישור (Slack Incoming Webhook, או n8n Webhook
# node שמעביר הלאה ל-WhatsApp/אימייל). בלי זה, הדוח רק ידפיס למסך.
APPROVAL_WEBHOOK_URL=
